+    sensor: 'Suomi NPP · VIIRS',
+    reads:
+      'The VIIRS match of MODIS 7-2-1: burn scars red-brown, vegetation green, active fire fronts glow orange.',
+    layer: 'VIIRS_SNPP_CorrectedReflectance_BandsM11-I2-I1',
