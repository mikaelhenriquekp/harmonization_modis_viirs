# Production env. In CI this file is written by the deploy workflow from GitHub
# variables/secrets; copy it to deploy/.env only for manual runs on the server.
DOMAIN=paparajotelunar.com
ACME_EMAIL=you@example.com
POSTGRES_USER=app
POSTGRES_DB=app
# Use URL-safe characters only (it is embedded in DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me
