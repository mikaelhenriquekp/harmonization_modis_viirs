APP_ENV=development
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://app:app@localhost:5433/app?sslmode=disable
# Only needed by the ingest and the raw hotspots CSV: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Optional: enables Ember, the AI fire analyst (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Questions per client an hour (0 = no limit) and how many at once
ASSISTANT_PER_HOUR=20
ASSISTANT_BURST=5
