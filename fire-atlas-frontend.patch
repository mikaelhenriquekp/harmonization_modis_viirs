+  {
+    id: 'snpp-true',
+    label: 'VIIRS true colour',
+    sensor: 'Suomi NPP · VIIRS',
+    reads: 'Bands I1-M4-M3, natural colour from the sensor that replaces MODIS.',
+    layer: 'VIIRS_SNPP_CorrectedReflectance_TrueColor',
