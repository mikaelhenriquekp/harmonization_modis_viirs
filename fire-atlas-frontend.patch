+    level: 9,
+    since: '2002-07-04',
+  },
+  {
+    id: 'aqua-721',
+    label: 'MODIS false colour 7-2-1',
+    sensor: 'Aqua · MODIS',
+    reads:
+      'Shortwave infrared in red: burn scars look red-brown, vegetation bright green, and the infrared sees through thin smoke.',
+    layer: 'MODIS_Aqua_CorrectedReflectance_Bands721',
+    format: 'jpg',
+    level: 9,
+    since: '2002-07-04',
